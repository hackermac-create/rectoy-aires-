# Copiez ce fichier en ".env" et complétez les valeurs.
# Ne commitez JAMAIS le fichier ".env" (ajoutez-le à .gitignore).

PORT=4000
NODE_ENV=development

# Générez une chaîne aléatoire longue, par exemple avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=remplacez_par_une_chaine_aleatoire_longue

# Identifiant de connexion à l'administration
ADMIN_USERNAME=admin

# Mot de passe HASHÉ (jamais en clair). Générez-le avec :
# node hash-password.js "VotreMotDePasseSolide"
ADMIN_PASSWORD_HASH=collez_ici_le_hash_genere_par_hash-password.js

# Domaines autorisés à appeler l'API, séparés par des virgules.
# Exemple : ALLOWED_ORIGINS=https://rectoy.ci,http://localhost:5500
ALLOWED_ORIGINS=http://localhost:4000,http://localhost:5500
